<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kiswah_texture">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALL FROM THE GOD"
            android:textColor="#D4AF62"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/citySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRAYER TIMES"
            android:textColor="#F7F0DF"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <Spinner
            android:id="@+id/citySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#D4AF62"
            android:contentDescription="Select city" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today's Date"
            android:textColor="#D4AF62"
            android:textSize="15sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/fajr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fajr"
            android:textColor="#174A35"
            android:textSize="20sp"
            android:padding="18dp"
            android:background="@drawable/prayer_card"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/sunrise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sunrise"
            android:textColor="#174A35"
            android:textSize="20sp"
            android:padding="18dp"
            android:background="@drawable/prayer_card"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/dhuhr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dhuhr"
            android:textColor="#174A35"
            android:textSize="20sp"
            android:padding="18dp"
            android:background="@drawable/prayer_card"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/asr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asr (Hanafi)"
            android:textColor="#174A35"
            android:textSize="20sp"
            android:padding="18dp"
            android:background="@drawable/prayer_card"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/maghrib"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Maghrib"
            android:textColor="#174A35"
            android:textSize="20sp"
            android:padding="18dp"
            android:background="@drawable/prayer_card"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/isha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Isha"
            android:textColor="#174A35"
            android:textSize="20sp"
            android:padding="18dp"
            android:background="@drawable/prayer_card"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prayer times are approximate"
            android:textColor="#D8CBAF"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
